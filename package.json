{
  "name": "static-webpage",
  "private": true,
  "version": "1.0.0",
  "description": "ML fundamentals static page and its deployment lifecycle",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:html": "html-validate index.html public/fundamentals.html public/modern-ai.html",
    "test:a11y": "playwright test",
    "test": "npm run test:html && npm run build && npm run test:a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "html-validate": "^8.24.0",
    "http-server": "^14.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "type": "module"
}
